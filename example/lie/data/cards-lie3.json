{
    "entries": [
        {
            "id": "rotation-reps",
            "section": "lie3",
            "type": "comparison",
            "title": "\u65cb\u8f6c\u7684\u56db\u79cd\u8868\u793a\uff08rotation representations\uff09",
            "question": "\u540c\u4e00\u4e2a\u4e09\u7ef4\u65cb\u8f6c\u6709\u56db\u79cd\u5e38\u7528\u8868\u793a\uff0c\u4ec0\u4e48\u60c5\u51b5\u4e0b\u8be5\u7528\u54ea\u4e00\u79cd\uff1f",
            "content_html": "<p>\u540c\u4e00\u4e2a\u4e09\u7ef4\u65cb\u8f6c\u6709\u56db\u79cd\u5e38\u7528\u8868\u793a\uff0c\u53d6\u820d\u7531\u53c2\u6570\u6570\u3001\u5947\u5f02\u6027\u3001\u662f\u5426\u9700\u8981\u63d2\u503c\u7ec4\u5408\u51b3\u5b9a\u3002</p><table class=\"tbl\"><tr><td>\u8868\u793a</td><td>\u53c2\u6570\u6570</td><td>\u5947\u5f02\u6027</td><td>\u5e94\u7528</td></tr><tr><td>\u65cb\u8f6c\u77e9\u9635 R \u2208 SO(3)</td><td>9\uff086 \u7ea6\u675f\uff09</td><td>\u65e0</td><td>\u901a\u7528\u53d8\u6362</td></tr><tr><td>\u6b27\u62c9\u89d2</td><td>3</td><td>\u6709\uff08\u4e07\u5411\u9501\uff09</td><td>\u52a8\u753b\u5173\u952e\u5e27</td></tr><tr><td>\u8f74\u89d2 (n\u0302, \u03b8)</td><td>3</td><td>\u03b8 = 0 \u5904</td><td>\u7269\u7406\u6a21\u62df</td></tr><tr><td>\u56db\u5143\u6570 q \u2208 SU(2)</td><td>4\uff081 \u7ea6\u675f\uff09</td><td>\u65e0</td><td>\u63d2\u503c\u3001\u7ec4\u5408</td></tr></table><p>\u77e9\u9635\u4fe1\u606f\u5197\u4f59\uff089 \u4e2a\u5206\u91cf\u53ea\u5bf9\u5e94 6 \u4e2a\u7ea6\u675f\uff09\u4f46\u65e0\u5947\u5f02\uff0c\u9002\u5408\u901a\u7528\u53d8\u6362\uff1b\u6b27\u62c9\u89d2\u53c2\u6570\u6700\u5c11\u3001\u4fbf\u4e8e\u4eba\u5de5\u8c03\u5173\u952e\u5e27\uff0c\u4ee3\u4ef7\u662f\u4e07\u5411\u9501\uff1b\u8f74\u89d2\u7269\u7406\u610f\u4e49\u6700\u76f4\u767d\uff0c\u4f46 \u03b8 = 0 \u65f6\u8f6c\u8f74\u65e0\u5b9a\u4e49\uff1b\u56db\u5143\u6570\u591a\u82b1\u4e00\u4e2a\u5206\u91cf\u4e70\u6765\u65e0\u5947\u5f02\u4e0e\u53ef\u63d2\u503c\u3001\u53ef\u7ec4\u5408\u3002</p>",
            "links": [
                "quaternion",
                "gimbal-lock",
                "slerp",
                "se3-screw"
            ],
            "tex_ref": "lie3.tex:196-209"
        },
        {
            "id": "quaternion",
            "section": "lie3",
            "type": "statement",
            "title": "\u56db\u5143\u6570\uff08quaternion\uff09\u4e0e SU(2)",
            "question": "\u5982\u4f55\u7528 4 \u4e2a\u5206\u91cf\u3001\u65e0\u5947\u5f02\u4e14\u53ef\u63d2\u503c\u5730\u8868\u793a\u4e09\u7ef4\u65cb\u8f6c\uff1f",
            "content_html": "<p>\u5355\u4f4d\u56db\u5143\u6570\uff08quaternion\uff09\u662f SU(2) \u7684\u5143\u7d20\uff0c\u7528 4 \u4e2a\u5206\u91cf 1 \u4e2a\u7ea6\u675f\u8868\u793a\u4e09\u7ef4\u65cb\u8f6c\u3002</p><div class=\"frm\">q = cos(\u03b8/2) + sin(\u03b8/2)(n\u0302<sub>x</sub>i + n\u0302<sub>y</sub>j + n\u0302<sub>z</sub>k)</div><p><strong>\u65cb\u8f6c\u4f5c\u7528\uff1a</strong>\u628a\u5411\u91cf v \u89c6\u4e3a\u7eaf\u865a\u56db\u5143\u6570\uff0c\u5219 v\u2032 = q v q<sup>\u22121</sup>\u3002</p><p><strong>\u4f18\u52bf\u56db\u6761\uff1a</strong></p><ul><li>\u65e0\u4e07\u5411\u9501\uff1b</li><li>\u7ec4\u5408\u65cb\u8f6c = \u56db\u5143\u6570\u4e58\u6cd5\uff0cO(1) vs \u77e9\u9635\u4e58\u6cd5 O(27)\uff1b</li><li>\u63d2\u503c\u81ea\u7136\uff08Slerp\uff09\uff1b</li><li>\u5f52\u4e00\u5316\u4fbf\u5b9c\uff08\u53ea 4 \u4e2a\u5206\u91cf\uff09\u3002</li></ul><p>\u5176\u4e2d \u03b8 \u4e0e n\u0302 \u6b63\u662f\u8f74\u89d2\u8868\u793a\u7684\u8f6c\u89d2\u4e0e\u8f6c\u8f74\uff0c\u6240\u4ee5\u56db\u5143\u6570\u662f\u8f74\u89d2\u7684\u65e0\u5947\u5f02\u5c01\u88c5\u3002</p>",
            "links": [
                "rotation-reps",
                "slerp",
                "gimbal-lock",
                "spin-projection"
            ],
            "tex_ref": "lie3.tex:211-223"
        },
        {
            "id": "slerp",
            "section": "lie3",
            "type": "statement",
            "title": "\u7403\u9762\u7ebf\u6027\u63d2\u503c\uff08Slerp\uff09",
            "question": "\u4e24\u4e2a\u65cb\u8f6c\u4e4b\u95f4\u5982\u4f55\u505a\u5149\u6ed1\u81ea\u7136\u7684\u8fc7\u6e21\u63d2\u503c\uff1f",
            "content_html": "<div class=\"frm\">Slerp(q<sub>0</sub>, q<sub>1</sub>, t) = sin((1\u2212t)\u03a9)/sin \u03a9 \u00b7 q<sub>0</sub> + sin(t\u03a9)/sin \u03a9 \u00b7 q<sub>1</sub></div><p>\u5176\u4e2d cos \u03a9 = q<sub>0</sub> \u00b7 q<sub>1</sub>\uff0c\u5373\u56db\u5143\u6570\u70b9\u79ef\u3002</p><p><strong>\u51e0\u4f55\u610f\u4e49\uff1a</strong>\u5728 S<sup>3</sup>\uff08\u5355\u4f4d\u56db\u5143\u6570\u7a7a\u95f4\uff09\u4e0a\u6cbf\u5927\u5706\u5f27\u63d2\u503c\u3002\u8fd9\u6b63\u662f\u56db\u5143\u6570\u300c\u63d2\u503c\u81ea\u7136\u300d\u7684\u4f9d\u636e\uff1a\u65cb\u8f6c\u4e0d\u5728\u5206\u91cf\u4e0a\u505a\u8fc7\u6e21\uff0c\u800c\u5728\u7403\u9762\u4e0a\u6cbf\u5927\u5706\u5f27\u8d70\u3002</p><p>\u5b83\u670d\u52a1\u4e8e\u5bf9\u7167\u8868\u4e2d\u56db\u5143\u6570\u7684\u5e94\u7528\u4e00\u680f\u2014\u2014\u300c\u63d2\u503c\u3001\u7ec4\u5408\u300d\u3002</p>",
            "links": [
                "quaternion",
                "rotation-reps"
            ],
            "tex_ref": "lie3.tex:225-233"
        },
        {
            "id": "gimbal-lock",
            "section": "lie3",
            "type": "counterexample",
            "title": "\u4e07\u5411\u9501\uff08gimbal lock\uff09",
            "question": "\u6b27\u62c9\u89d2\u5728\u4ec0\u4e48\u59ff\u6001\u4e0b\u4f1a\u4e22\u5931\u4e00\u4e2a\u81ea\u7531\u5ea6\uff0c\u56db\u5143\u6570\u4e3a\u4ec0\u4e48\u4e0d\u4f1a\uff1f",
            "content_html": "<p>\u6b27\u62c9\u89d2\u5728\u7279\u5b9a\u59ff\u6001\u4e0b\u4f1a\u5931\u53bb\u4e00\u4e2a\u81ea\u7531\u5ea6\uff0c\u8fd9\u5c31\u662f\u4e07\u5411\u9501\uff08gimbal lock\uff09\u3002</p><p>\u5177\u4f53\u673a\u5236\uff1a\u4ee5\u4f9d\u6b21\u7ed5\u4e09\u4e2a\u8f74\u8f6c\u52a8\u4e3a\u4f8b\uff0c\u7b2c\u4e00\u6b21\u4e0e\u7b2c\u4e09\u6b21\u65cb\u8f6c\u7684\u8f6c\u8f74\u521d\u59cb\u4e92\u76f8\u5782\u76f4\uff0c\u4e0e\u7b2c\u4e8c\u6b21\u7684\u8f6c\u8f74\u4e00\u8d77\u5f20\u6210 3 \u4e2a\u72ec\u7acb\u65b9\u5411\u3002\u5f53\u7b2c\u4e8c\u6b21\u65cb\u8f6c\u7684\u89d2\u5ea6\uff08\u4fef\u4ef0\u89d2\uff09\u53d6 \u00b190\u00b0 \u65f6\uff0c\u7b2c\u4e00\u6b21\u4e0e\u7b2c\u4e09\u6b21\u7684\u8f6c\u8f74\u88ab\u8f6c\u5230\u91cd\u5408\u65b9\u5411\u2014\u2014\u4e24\u4e2a\u89d2\u6539\u53d8\u7684\u662f\u540c\u4e00\u79cd\u8f6c\u52a8\uff0c3 \u4e2a\u53c2\u6570\u53ea\u5269 2 \u4e2a\u72ec\u7acb\u81ea\u7531\u5ea6\uff0c\u59ff\u6001\u7a7a\u95f4\u5728\u8be5\u5904\u51fa\u73b0\u5947\u5f02\u3002</p><p>\u5bf9\u7167\u8868\u91cc\u6b27\u62c9\u89d2\u4e00\u680f\u7684\u5947\u5f02\u6027\u6807\u6ce8\u6b63\u662f\u300c\u6709\uff08\u4e07\u5411\u9501\uff09\u300d\u3002</p><p>\u56db\u5143\u6570\u662f 4 \u53c2\u6570 1 \u7ea6\u675f\u3001\u65e0\u5947\u5f02\uff0c\u4e0d\u5b58\u5728\u300c\u67d0\u4e24\u6b21\u65cb\u8f6c\u5171\u8f74\u300d\u8fd9\u7c7b\u9000\u5316\u59ff\u6001\uff0c\u8fd9\u6b63\u662f\u4f18\u52bf\u7b2c\u4e00\u6761\u300c\u65e0\u4e07\u5411\u9501\u300d\u7684\u542b\u4e49\u3002</p>",
            "links": [
                "rotation-reps",
                "quaternion",
                "slerp"
            ],
            "tex_ref": "lie3.tex:203-223"
        },
        {
            "id": "se3-screw",
            "section": "lie3",
            "type": "statement",
            "title": "\u521a\u4f53\u8fd0\u52a8 SE(3) \u4e0e\u87ba\u65cb\u8fd0\u52a8\uff08screw motion\uff09",
            "question": "\u521a\u4f53\u7684\u4e00\u822c\u4f4d\u59ff\uff08\u65cb\u8f6c + \u5e73\u79fb\uff09\u5982\u4f55\u7528\u77e9\u9635\u4e0e\u6307\u6570\u6620\u5c04\u7edf\u4e00\u63cf\u8ff0\uff1f",
            "content_html": "<p>\u521a\u4f53\u53d8\u6362\u7528\u9f50\u6b21\u77e9\u9635\u8868\u793a\uff0cR \u2208 SO(3)\u3001t \u2208 \u211d<sup>3</sup>\uff1a</p><table class=\"mtx\"><tr><td>R</td><td>t</td></tr><tr><td>0<sup>T</sup></td><td>1</td></tr></table><p>\u5176\u674e\u4ee3\u6570 se(3) \u7531\u65cb\u8f6c\u5757\u4e0e\u5e73\u79fb\u5757\u62fc\u6210\uff1a</p><table class=\"mtx\"><tr><td>[\u03c9]<sub>\u00d7</sub></td><td>v</td></tr><tr><td>0<sup>T</sup></td><td>0</td></tr></table><p><strong>\u6307\u6570\u6620\u5c04\u7ed9\u51fa\u87ba\u65cb\u8fd0\u52a8</strong>\uff0c\u7ed3\u679c\u4e3a\uff1a</p><table class=\"mtx\"><tr><td>e<sup>[\u03c9]<sub>\u00d7</sub></sup></td><td>Vv</td></tr><tr><td>0<sup>T</sup></td><td>1</td></tr></table><p>\u5176\u4e2d V = I + (1\u2212cos \u03b8)/\u03b8<sup>2</sup>\u00b7[\u03c9]<sub>\u00d7</sub> + (\u03b8\u2212sin \u03b8)/\u03b8<sup>3</sup>\u00b7[\u03c9]<sub>\u00d7</sub><sup>2</sup>\uff0c\u95ed\u5408\u5f62\u5f0f\uff0c\u65e0\u9700\u7ea7\u6570\u622a\u65ad\u3002</p><p><strong>CG \u5e94\u7528\uff1a</strong>\u9aa8\u9abc\u52a8\u753b\u7684\u5173\u8282\u53d8\u6362\u3001\u76f8\u673a\u8fd0\u52a8\u3001\u673a\u5668\u4eba\u5b66\u3002</p>",
            "links": [
                "rotation-reps",
                "quaternion",
                "unified-table"
            ],
            "tex_ref": "lie3.tex:235-256"
        },
        {
            "id": "spin-projection",
            "section": "lie3",
            "type": "intuition",
            "title": "\u81ea\u65cb\u4e3a\u4f55\u7528 SU(2)\uff1a\u6295\u5f71\u8868\u793a\uff08projective representation\uff09",
            "question": "\u91cf\u5b50\u81ea\u65cb\u4e3a\u4ec0\u4e48\u5fc5\u987b\u7528 SU(2) \u800c\u4e0d\u662f SO(3) \u63cf\u8ff0\uff1f",
            "content_html": "<p>\u91cf\u5b50\u529b\u5b66\u4e2d\u65cb\u8f6c\u4f5c\u7528\u5728\u6001\u7a7a\u95f4\u4e0a\uff0c\u800c\u6295\u5f71\u8868\u793a\u5141\u8bb8\u6574\u4f53\u5dee\u4e00\u4e2a\u76f8\u4f4d\u3002</p><p>\u5173\u952e\u62d3\u6251\u4e8b\u5b9e\uff1a\u03c0<sub>1</sub>(SO(3)) = \u2124<sub>2</sub>\u3002SO(3) \u7684\u6295\u5f71\u8868\u793a\uff08\u5141\u8bb8\u76f8\u4f4d\uff09\u7b49\u4ef7\u4e8e SU(2) \u7684\u666e\u901a\u8868\u793a\u2014\u2014\u8fd9\u5c31\u662f\u81ea\u65cb\u5fc5\u987b\u7528 SU(2) \u800c\u975e SO(3) \u7684\u539f\u56e0\u3002\u7535\u5b50\u81ea\u65cb s = 1/2 \u6b63\u662f SU(2) \u7684 2 \u7ef4\u8868\u793a\u3002</p><div class=\"frm\">[L\u0302<sub>i</sub>, L\u0302<sub>j</sub>] = i\u0127 \u03b5<sub>ijk</sub> L\u0302<sub>k</sub></div><p>\u6c22\u539f\u5b50\u53e6\u6709\u9690\u85cf\u5bf9\u79f0\u6027\uff1a\u9664\u89d2\u52a8\u91cf L \u5916\u8fd8\u6709 Runge\u2013Lenz \u5411\u91cf A\uff0c\u4e8c\u8005\u5171\u540c\u751f\u6210 so(4) \u2245 su(2) \u2295 su(2)\u3002\u7531\u6b64\u80fd\u7ea7 E<sub>n</sub> \u7684\u7b80\u5e76\u5ea6\u662f n<sup>2</sup>\uff0c\u800c\u975e\u4ec5 2l+1\u3002</p>",
            "links": [
                "quaternion",
                "spherical-harmonics",
                "unified-table"
            ],
            "tex_ref": "lie3.tex:23-40"
        },
        {
            "id": "yang-mills",
            "section": "lie3",
            "type": "application",
            "title": "Yang\u2013Mills \u89c4\u8303\u573a\u8bba\uff08gauge theory\uff09",
            "question": "\u8981\u6c42\u5c40\u90e8\u89c4\u8303\u4e0d\u53d8\uff0c\u4e3a\u4ec0\u4e48\u4f1a\u300c\u903c\u51fa\u300d\u4f20\u9012\u76f8\u4e92\u4f5c\u7528\u7684\u529b\u7c92\u5b50\uff1f",
            "content_html": "<p><strong>\u6838\u5fc3\u601d\u60f3\uff1a</strong>\u8981\u6c42\u62c9\u683c\u6717\u65e5\u91cf\u5728<strong>\u5c40\u90e8</strong>\u89c4\u8303\u53d8\u6362\u4e0b\u4e0d\u53d8 \u2192 \u5fc5\u987b\u5f15\u5165\u89c4\u8303\u573a\uff08\u8054\u7edc\uff09\u2192 \u89c4\u8303\u573a\u5c31\u662f\u529b\u3002</p><table class=\"tbl\"><tr><td>\u89c4\u8303\u7fa4</td><td>\u89c4\u8303\u573a</td><td>\u529b</td><td>\u7c92\u5b50</td></tr><tr><td>U(1)</td><td>A<sub>\u03bc</sub>\uff081 \u4e2a\uff09</td><td>\u7535\u78c1\u529b</td><td>\u5149\u5b50</td></tr><tr><td>SU(2)</td><td>W<sub>\u03bc</sub><sup>a</sup>\uff083 \u4e2a\uff09</td><td>\u5f31\u529b</td><td>W<sup>\u00b1</sup>, Z<sup>0</sup></td></tr><tr><td>SU(3)</td><td>G<sub>\u03bc</sub><sup>a</sup>\uff088 \u4e2a\uff09</td><td>\u5f3a\u529b</td><td>8 \u4e2a\u80f6\u5b50</td></tr></table><p>\u6807\u51c6\u6a21\u578b\u7684\u7fa4\u7ed3\u6784\uff1aG<sub>SM</sub> = SU(3)<sub>C</sub> \u00d7 SU(2)<sub>L</sub> \u00d7 U(1)<sub>Y</sub>\uff0c\u5176\u4e2d SU(3)<sub>C</sub> \u4e3a\u8272\u5bf9\u79f0\u3001SU(2)<sub>L</sub> \u4e3a\u5f31\u540c\u4f4d\u65cb\u3001U(1)<sub>Y</sub> \u4e3a\u5f31\u8d85\u8377\u3002</p><p><strong>\u6570\u5b66\u7ed3\u6784\uff1a</strong>\u89c4\u8303\u573a = \u4e3b\u4e1b\u4e0a\u7684\u8054\u7edc A = A<sub>\u03bc</sub><sup>a</sup>T<sub>a</sub>dx<sup>\u03bc</sup>\uff1b\u573a\u5f3a = \u66f2\u7387 F = dA + A\u2227A\u3002</p>",
            "links": [
                "noether",
                "unified-table"
            ],
            "tex_ref": "lie3.tex:42-89"
        },
        {
            "id": "noether",
            "section": "lie3",
            "type": "application",
            "title": "Noether \u5b9a\u7406\u4e0e\u77e9\u6620\u5c04\uff08moment map\uff09",
            "question": "\u8fde\u7eed\u5bf9\u79f0\u6027\u51ed\u4ec0\u4e48\u7ed9\u51fa\u5b88\u6052\u91cf\uff0c\u8fd9\u4e2a\u5bf9\u5e94\u600e\u4e48\u5199\u6210\u674e\u7fa4\u8bed\u8a00\uff1f",
            "content_html": "<p><strong>Noether \u5b9a\u7406\u7684\u674e\u7fa4\u8868\u8ff0\uff1a</strong>\u82e5\u4f5c\u7528\u91cf S = \u222bL dt \u5728\u4e00\u53c2\u6570\u7fa4 g<sub>\u03b5</sub> \u4e0b\u4e0d\u53d8\uff0c\u5219</p><div class=\"frm\">Q = (\u2202L/\u2202q\u0307) \u00b7 \u03b4q</div><p>\u662f\u5b88\u6052\u91cf\u3002</p><p><strong>\u77e9\u6620\u5c04\uff08moment map\uff09\uff1a</strong>\u628a\u5bf9\u79f0\u7fa4\u7684\u674e\u4ee3\u6570\u6574\u4f53\u6620\u5c04\u5230\u76f8\u7a7a\u95f4\u4e0a\u7684\u5b88\u6052\u91cf\uff0c</p><div class=\"frm\">\u03bc: g \u2192 C<sup>\u221e</sup>(M)\uff0cX \u21a6 \u03bc<sub>X</sub>\uff0c\u6ee1\u8db3 {\u03bc<sub>X</sub>, f} = X<sub>M</sub>(f)</div><p>\u5176\u4e2d X<sub>M</sub> \u662f X \u5728\u76f8\u7a7a\u95f4 M \u4e0a\u8bf1\u5bfc\u7684\u5411\u91cf\u573a\u3002</p><p><strong>\u4e09\u4e2a\u4f8b\u5b50\uff1a</strong>\u5e73\u79fb\u5bf9\u79f0 \u2192 \u52a8\u91cf p\uff1b\u65cb\u8f6c\u5bf9\u79f0 \u2192 \u89d2\u52a8\u91cf L = r \u00d7 p\uff1b\u65f6\u95f4\u5e73\u79fb \u2192 \u80fd\u91cf H\u3002</p>",
            "links": [
                "yang-mills",
                "unified-table"
            ],
            "tex_ref": "lie3.tex:166-188"
        },
        {
            "id": "spherical-harmonics",
            "section": "lie3",
            "type": "application",
            "title": "\u7403\u8c10\u51fd\u6570\uff08spherical harmonics\uff09\u4e0e SO(3) \u8868\u793a",
            "question": "\u7403\u9762\u4e0a\u7684\u51fd\u6570\uff08\u542b\u73af\u5883\u5149\u7167\uff09\u5982\u4f55\u7528\u4e0d\u53ef\u7ea6\u8868\u793a\u7684\u57fa\u5c55\u5f00\u4e0e\u5feb\u901f\u5377\u79ef\uff1f",
            "content_html": "<p>\u7403\u8c10\u51fd\u6570\uff08spherical harmonics\uff09\u662f SO(3) \u4e0d\u53ef\u7ea6\u8868\u793a\u7684\u57fa\u51fd\u6570\uff1aY<sub>l</sub><sup>m</sup>(\u03b8, \u03c6) \u662f\u7b2c l \u4e2a\u4e0d\u53ef\u7ea6\u8868\u793a\uff08\u7ef4\u5ea6 2l+1\uff09\u7684\u57fa\u3002</p><p><strong>\u65cb\u8f6c\u4e0b\u7684\u53d8\u6362\uff1a</strong></p><div class=\"frm\">Y<sub>l</sub><sup>m</sup>(R<sup>\u22121</sup>n\u0302) = \u03a3<sub>m\u2032=\u2212l</sub><sup>l</sup> D<sup>l</sup><sub>m\u2032m</sub>(R) Y<sub>l</sub><sup>m\u2032</sup>(n\u0302)</div><p>D<sup>l</sup><sub>m\u2032m</sub>(R) \u662f Wigner D-\u77e9\u9635\uff0c\u5373 (2l+1)\u00d7(2l+1) \u7684\u9149\u77e9\u9635\u3002</p><p><strong>\u6e32\u67d3\u5e94\u7528\uff1a</strong>\u73af\u5883\u5149\u7167\u7528\u7403\u8c10\u7cfb\u6570 L(n\u0302) \u2248 \u03a3<sub>l=0</sub><sup>L</sup> \u03a3<sub>m=\u2212l</sub><sup>l</sup> c<sub>l</sub><sup>m</sup>Y<sub>l</sub><sup>m</sup>(n\u0302) \u8868\u793a\uff0c\u901a\u5e38 L = 2\uff089 \u4e2a\u7cfb\u6570\uff09\u5373\u53ef\u8868\u793a\u4f4e\u9891\u73af\u5883\u5149\uff1bPRT \u628a\u4f20\u8f93\u7b97\u5b50\u5728\u7403\u8c10\u57fa\u4e0a\u5bf9\u89d2\u5316\uff0c\u5b9e\u73b0\u5b9e\u65f6\u5168\u5c40\u5149\u7167\uff1b\u7403\u9762\u5377\u79ef\u5728\u7403\u8c10\u57df\u53d8\u6210\u9010\u5143\u7d20\u4e58\u6cd5\uff08\u5377\u79ef\u5b9a\u7406\u7684\u7403\u9762\u7248\u672c\uff09\u3002</p>",
            "links": [
                "spin-projection",
