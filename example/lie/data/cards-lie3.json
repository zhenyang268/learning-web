            "title": "\u7edf\u4e00\u5bf9\u5e94\u8868\uff08unified correspondence\uff09",
            "question": "\u674e\u7fa4\u3001\u674e\u4ee3\u6570\u3001\u8868\u793a\u3001\u6307\u6570\u6620\u5c04\u8fd9\u4e9b\u6982\u5ff5\u5728\u56db\u4e2a\u9886\u57df\u91cc\u5206\u522b\u662f\u540c\u4e00\u4ef6\u4e8b\u7684\u54ea\u4e00\u9762\uff1f",
            "content_html": "<p>\u540c\u4e00\u5957\u7ed3\u6784\u5728\u56db\u4e2a\u9886\u57df\u53cd\u590d\u51fa\u73b0\uff0c\u8fd9\u5f20\u8868\u662f\u674e\u7fa4\u2013\u674e\u4ee3\u6570\u2013\u62d3\u6251\u7edf\u4e00\u89c6\u89d2\u7684\u603b\u7ed3\u3002</p><table class=\"tbl\"><tr><td>\u6570\u5b66</td><td>\u7269\u7406</td><td>CG</td><td>\u5fae\u5206\u65b9\u7a0b</td></tr><tr><td>\u674e\u7fa4</td><td>\u5bf9\u79f0\u7fa4</td><td>\u53d8\u6362\u7fa4</td><td>\u5bf9\u79f0\u6027</td></tr><tr><td>\u674e\u4ee3\u6570</td><td>\u5b88\u6052\u91cf\u4ee3\u6570</td><td>\u65e0\u7a77\u5c0f\u53d8\u6362</td><td>\u964d\u9636\u751f\u6210\u5143</td></tr><tr><td>\u8868\u793a</td><td>\u7c92\u5b50\u5206\u7c7b</td><td>\u7403\u8c10/\u5085\u91cc\u53f6</td><td>\u7279\u5f81\u51fd\u6570</td></tr><tr><td>\u6307\u6570\u6620\u5c04</td><td>\u65f6\u95f4\u6f14\u5316</td><td>\u65cb\u8f6c\u63d2\u503c</td><td>\u77e9\u9635\u6307\u6570\u89e3</td></tr><tr><td>\u8986\u76d6\u7fa4</td><td>\u81ea\u65cb</td><td>\u56db\u5143\u6570</td><td>\u591a\u503c\u89e3</td></tr><tr><td>\u7279\u5f81\u7c7b</td><td>\u62d3\u6251\u8377</td><td>\u7f51\u683c\u62d3\u6251</td><td>\u6307\u6807\u5b9a\u7406</td></tr></table><p>\u4e09\u6761\u4e3b\u7ebf\uff1a\u674e\u7fa4 \u2194\uff08\u6307\u6570\u6620\u5c04\uff09\u674e\u4ee3\u6570\uff1b\u674e\u7fa4 \u2194\uff08\u57fa\u672c\u7fa4 / \u8986\u76d6\uff09\u62d3\u6251\uff1b\u674e\u4ee3\u6570 \u2194\uff08\u8868\u793a\u8bba\uff09\u7269\u7406\u3002</p>",
