{
  "name": "learning-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:standalone",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:standalone": "node tools/build-standalone.mjs",
    "check:viz": "node tools/viz-model-check.mjs",
    "check:graph": "node tools/check-graph.mjs",
    "check:sem-sync": "node tools/check-sem-sync.mjs",
    "check": "tsc --noEmit && npm run check:graph && npm run check:sem-sync && npm run check:viz && node tools/dom-harness.mjs --all"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "katex": "^0.18.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
